---
export interface Props { label?: string; name?: string }
const { label = 'Drop a file or browse', name = 'file' } = Astro.props;
---

<label class="grid h-24 cursor-pointer place-items-center border-2 border-dashed border-black text-sm font-semibold dark:border-white"><input class="sr-only" name={name} type="file" />{label}</label>

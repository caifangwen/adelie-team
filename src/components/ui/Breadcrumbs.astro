---
export interface Props { items?: Array<{ text: string; href?: string }> }
const { items = [] } = Astro.props;
---

<nav aria-label="Breadcrumb"><ol class="flex flex-wrap gap-2 text-sm">{items.map((item, index) => <><li>{item.href ? <a class="underline" href={item.href}>{item.text}</a> : <span aria-current="page" class="font-bold">{item.text}</span>}</li>{index < items.length - 1 && <li aria-hidden="true">/</li>}</>)}</ol></nav>

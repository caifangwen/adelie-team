---
import Image from '~/components/common/Image.astro';

const members = [
  {
    name: 'Lin Chen',
    role: '增长策略',
    description: '梳理业务目标、页面优先级与流量路径。',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e',
  },
  {
    name: 'Mia Zhou',
    role: '体验设计',
    description: '让复杂的产品与证据更容易被理解和选择。',
    image: 'https://images.unsplash.com/photo-1554151228-14d9def656e4',
  },
  {
    name: 'Alex Wu',
    role: '技术与追踪',
    description: '负责网站实现、数据基础和上线后的验证。',
    image: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d',
  },
];
---

<section class="relative not-prose bg-secondary/5 dark:bg-white/5">
  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16 lg:py-20">
    <div class="mx-auto mb-8 max-w-3xl text-center md:mb-12">
      <p class="text-sm font-bold tracking-wide text-primary uppercase">TEAM</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tighter md:text-4xl">协作角色</h2>
      <p class="mt-3 text-muted">以下成员为页面展示示意，正式发布时替换为真实团队资料。</p>
    </div>
    <div class="grid gap-8 md:grid-cols-3">
      {
        members.map((member) => (
          <article class="overflow-hidden border-2 border-black bg-page shadow-[6px_6px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff]">
            <Image
              src={member.image}
              alt={`${member.name}，${member.role}（示意）`}
              width={600}
              height={600}
              widths={[400, 600]}
              layout="full-width"
              class="aspect-square w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-2xl font-bold">{member.name}</h3>
              <p class="mt-1 font-semibold text-primary">{member.role}</p>
              <p class="mt-3 text-muted">{member.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import Image from '~/components/common/Image.astro';

const items = [
  {
    title: '工业制造与设备',
    subtitle: '产品、应用与技术询盘',
    href: '/solutions/industrial-manufacturing',
    image: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758',
    featured: true,
  },
  {
    title: 'DTC 品牌出海',
    subtitle: '品牌、首购与复购',
    href: '/solutions/dtc-brand',
    image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03',
    featured: true,
  },
  {
    title: '跨境电商',
    subtitle: '多市场与商品增长',
    href: '/solutions/cross-border-ecommerce',
    image: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d',
  },
  {
    title: '新能源与工程',
    subtitle: '能力、项目与长周期线索',
    href: '/solutions/renewable-energy-engineering',
    image: 'https://images.unsplash.com/photo-1508514177221-188b1cf16e9d',
  },
  {
    title: '家居生活方式',
    subtitle: '场景、商品与多市场成交',
    href: '/solutions/home-lifestyle',
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6',
  },
  {
    title: '企业官网获客',
    subtitle: '服务、证据与销售线索',
    href: '/solutions/corporate-lead-gen',
    image: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2',
  },
];
---

<section class="relative not-prose py-12 md:py-20">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="text-sm font-bold tracking-[0.16em] text-primary">INDUSTRY STORIES</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight md:text-5xl">从真实业务场景进入方案。</h2>
      </div>
      <span class="hidden text-sm font-bold md:block">06 SCENES / 08 SOLUTIONS</span>
    </div>
    <div class="grid auto-rows-[19rem] gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={[
              'group relative overflow-hidden border-2 border-black bg-black shadow-[6px_6px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff]',
              item.featured && 'lg:col-span-2',
            ]}
          >
            <Image
              src={item.image}
              alt={item.title}
              width={1000}
              height={700}
              widths={[480, 768, 1000]}
              sizes={item.featured ? '(max-width: 1024px) 100vw, 50vw' : '(max-width: 1024px) 50vw, 25vw'}
              layout="full-width"
              class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-60"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/70 to-transparent p-6 pt-20 text-white">
              <p class="text-sm font-bold tracking-widest text-accent">{item.subtitle}</p>
              <h3 class="mt-2 text-2xl font-bold md:text-3xl">{item.title}</h3>
              <span class="mt-4 inline-block font-bold underline underline-offset-4">查看方案 →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

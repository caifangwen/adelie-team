---
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import CaseStudyGrid from '~/components/adelie/CaseStudyGrid.astro';
import CaseDetail from '~/components/adelie/CaseDetail.astro';
import TeamGrid from '~/components/adelie/TeamGrid.astro';
import PartnerGrid from '~/components/adelie/PartnerGrid.astro';
import SolutionCards from '~/components/adelie/SolutionCards.astro';

interface Props {
  body: string;
  path: string;
  children?: Array<{
    title: string;
    path: string;
    body: string;
    data?: { excerpt?: string; image?: string; category?: string; readingTime?: string };
  }>;
}

type Item = { title: string; description?: string };
type SectionImage = { src: string; alt: string };
type Section = { title: string; subtitle?: string; image?: SectionImage; items: Item[] };

const { body, path, children = [] } = Astro.props;

const clean = (value: string) =>
  value
    .replaceAll('`', '')
    .replace(/^[-–—\s]+|[-–—\s]+$/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const itemFrom = (line: string): Item => {
  const text = clean(line);
  const divider = text.search(/[：:]/);
  if (divider < 0) return { title: text };

  return { title: clean(text.slice(0, divider)), description: clean(text.slice(divider + 1)) };
};

/** 抽取“图片”行并移除出条目列表，返回图片地址（description 为空时从 title 里剥离前缀） */
const takeImage = (items: Item[], alt: string): { rest: Item[]; image?: SectionImage } => {
  const index = items.findIndex((item) => /^(图片|配图|主图)/.test(item.title));
  if (index < 0) return { rest: items };

  const item = items[index];
  const src = item.description || item.title.replace(/^(图片|配图|主图)[:：]?/, '').trim();
  return {
    rest: items.filter((_, i) => i !== index),
    image: src ? { src, alt } : undefined,
  };
};

const title = clean(body.match(/^#\s+(.+)$/m)?.[1] ?? 'Adelie');
const sections: Section[] = body
  .split(/^##\s+/m)
  .slice(1)
  .map((block) => {
    const [heading = '', ...lines] = block.split('\n');
    const subtitle = clean(
      lines
        .filter((line) => /^>\s?/.test(line))
        .join(' ')
        .replaceAll(/^>\s?/g, '')
    );
    const rawItems = lines
      .filter((line) => /^-\s+/.test(line))
      .map((line) => itemFrom(line.replace(/^-\s+/, '')))
      .filter((item) => item.title && !/^(组件|Footer)/.test(item.title));
    const sectionTitle = clean(heading.replace(/^\d+\.\s*/, ''));
    const { rest, image } = takeImage(rawItems, sectionTitle);
    return {
      title: sectionTitle,
      subtitle: subtitle || undefined,
      image,
      items: rest,
    };
  })
  .filter((section) => section.items.length > 0);

const hero = sections.find((section) => /Hero|Article Header/.test(section.title));
const heroValue = (label: RegExp) => hero?.items.find((item) => label.test(item.title));
const heroTitle = heroValue(/标题/)?.description || title;
const heroSubtitle =
  heroValue(/正文|摘要|辅助说明/)?.description || hero?.items.find((item) => item.description)?.description;
const heroTagline = heroValue(/眉题/)?.description || path.split('/')[0]?.toUpperCase();
const heroImage = hero?.image;
const isCaseArchive = /^cases\/[^/]+$/.test(path);
const isCaseDetail = /^cases\/[^/]+\/[^/]+$/.test(path);
const isResourceArchive = /^resources\/[^/]+$/.test(path);
const isResourceDetail = /^resources\/[^/]+\/[^/]+$/.test(path);
const isTeamPage = path === 'about/team';
const isPartnersPage = path === 'about/partners';
const isAboutPage = /^about\//.test(path);
const isSolutionPage = /^solutions\//.test(path);
const resourceListSection = sections.find(
  (section) => isResourceArchive && /分类与文章列表|工具列表/.test(section.title)
);
const resourceGridTitle = path.endsWith('/tools') ? '全部工具与资料' : '全部文章';
const resourceActionText = path.endsWith('/tools') ? '查看清单' : '阅读文章';
const resourceCategories = (resourceListSection?.items.find((item) => /分类/.test(item.title))?.description ?? '')
  .split('、')
  .map(clean)
  .filter(Boolean);
const caseListSection = sections.find((section) => isCaseArchive && /筛选与列表/.test(section.title));
const caseCategories = (caseListSection?.items.find((item) => /筛选/.test(item.title))?.description ?? '')
  .split('、')
  .map(clean)
  .filter((category) => category && category !== '全部');
const caseMetrics = (heroValue(/成果/)?.description ?? '')
  .split(/[、，,]/)
  .map(clean)
  .filter(Boolean);
const caseNotice = heroValue(/注/)?.description;
const caseCards = children.map((child) => {
  const value = (label: RegExp) => {
    const line = child.body.split('\n').find((line) => /^-\s+/.test(line) && label.test(line));
    return line ? itemFrom(line.replace(/^-\s+/, '')).description : undefined;
  };
  const tags = (value(/标签/) ?? '').split('｜').map(clean).filter(Boolean);
  return {
    title: clean(child.title.replace(/^案例详情：/, '')),
    path: child.path,
    tagline: tags.join('｜'),
    categories: caseCategories.filter((category) => tags.includes(category)),
    description: value(/标题/),
    image: value(/^(图片|配图|主图)/),
    metrics: (value(/成果/) ?? '')
      .split(/[、，,]/)
      .map(clean)
      .filter(Boolean),
  };
});
const resourceCards = children.map((child) => {
  const value = (label: RegExp) => {
    const line = child.body.split('\n').find((line) => /^-\s+/.test(line) && label.test(line));
    return line ? itemFrom(line.replace(/^-\s+/, '')).description : undefined;
  };
  return {
    title: clean(child.data?.title || value(/标题/) || child.title.replace(/^(文章详情|下载页)：/, '')),
    path: child.path,
    tagline: child.data?.category || value(/分类/) || '实用资源',
    categories: [child.data?.category || (value(/分类/) || '实用资源').split('；')[0]],
    description: child.data?.excerpt || value(/摘要|正文/) || undefined,
    image: child.data?.image || value(/^(图片|配图|主图)/),
    metrics: [],
  };
});
const action = heroValue(/按钮|下载|获取|申请/);
const ctaSection = sections.find((section) => /CTA/.test(section.title));
const ctaAction = ctaSection?.items.find((item) => /按钮/.test(item.title));
const visibleSections = sections.filter(
  (section) =>
    !section.title.includes('Hero') &&
    !section.title.includes('Article Header') &&
    !/Header|Footer|CTA/.test(section.title) &&
    !(isCaseArchive && /筛选与列表|代表案例/.test(section.title)) &&
    !(isResourceArchive && /分类与文章列表|工具列表/.test(section.title)) &&
    !(isPartnersPage && /认证与合作伙伴/.test(section.title))
);
const isProcess = (section: Section) =>
  /流程|阶段|节奏|闭环|路径|目录|推进|步骤/.test(section.title) ||
  (path === 'about/process' && /启动|执行|持续/.test(section.title));
const isFaq = (section: Section) => /FAQ/.test(section.title);

/** 流程页里的“表单提示 / 关键指标”这类备注，提升为区块副标题 */
const isFlowNote = (item: Item) => /提示|指标|备注|说明/.test(item.title) && !!item.description;

/** 把 “A → B → C” 箭头流程拆成逐步的步骤 */
const flowItems = (items: Item[]): Item[] =>
  items.flatMap((item) =>
    item.title.includes('→') ? item.title.split('→').map((stage) => ({ title: clean(stage) })) : [item]
  );

const solutionFlowIcon = (title: string) => {
  if (/搜索|广告|社媒|流量/.test(title)) return 'tabler:search';
  if (/产品|页面|商店|市场配置|落地页/.test(title)) return 'tabler:layout-dashboard';
  if (/案例|规格|FAQ|能力证明/.test(title)) return 'tabler:shield-check';
  if (/加购|结账|订单/.test(title)) return 'tabler:shopping-cart';
  if (/报价|样品|咨询|表单/.test(title)) return 'tabler:file-text';
  if (/CRM|邮件|短信|销售跟进|归因|优化/.test(title)) return 'tabler:chart-line';
  return 'tabler:arrow-right';
};

const flowSubtitle = (section: Section): string | undefined => {
  const note = section.items
    .filter(isFlowNote)
    .map((item) => `${item.title}：${item.description}`)
    .join(' ');
  return [section.subtitle, note].filter(Boolean).join(' ') || undefined;
};

const altBg = '<div class="absolute inset-0 bg-secondary/5 dark:bg-white/5"></div>';
---

{
  isCaseDetail || isResourceDetail ? (
    <CaseDetail
      title={heroTitle}
      tagline={heroValue(/标签|分类/)?.description || (isResourceDetail ? '实用资源' : undefined)}
      subtitle={heroSubtitle}
      image={heroImage}
      metrics={isCaseDetail ? caseMetrics : []}
      notice={isCaseDetail ? caseNotice : undefined}
      sections={visibleSections}
      ctaTitle={
        isResourceDetail
          ? clean(ctaSection?.items.find((item) => /标题|文案/.test(item.title))?.description ?? '') ||
            '需要进一步梳理优先级？'
          : undefined
      }
      ctaSubtitle={isResourceDetail ? '把资源中的检查项应用到你的站点、内容或广告账户后，再决定下一步。' : undefined}
      ctaAction={isResourceDetail ? '获取初步建议' : undefined}
    />
  ) : heroImage ? (
    <section class="relative md:-mt-[76px] not-prose">
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
        <div class="pt-0 md:pt-[76px] pointer-events-none" />
        <div class="py-12 md:py-20">
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            <div>
              {heroTagline && (
                <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  {heroTagline}
                </p>
              )}
              <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {heroTitle}
              </h1>
              {heroSubtitle && (
                <p class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  {heroSubtitle}
                </p>
              )}
              {action && (
                <div class="flex flex-col sm:flex-row gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  <Button
                    variant="primary"
                    text={action.description || action.title}
                    href="/contact"
                    class="w-full sm:w-auto"
                  />
                </div>
              )}
            </div>
            <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              <Image
                src={heroImage.src}
                alt={heroImage.alt}
                width={1200}
                height={675}
                widths={[400, 768, 1200]}
                layout="full-width"
                class="w-full border-2 border-black shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff]"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <HeroText
      title={heroTitle}
      subtitle={heroSubtitle}
      tagline={heroTagline}
      callToAction={
        action ? { variant: 'primary', text: action.description || action.title, href: '/contact' } : undefined
      }
    />
  )
}

{isTeamPage && <TeamGrid />}

{
  !isCaseDetail &&
    !isResourceDetail &&
    visibleSections.map((section, index) => {
      const bg = index % 2 === 1 ? altBg : undefined;
      const aboutIcon = !isAboutPage
        ? undefined
        : /原则/.test(section.title)
          ? 'tabler:check'
          : /平台|认证|伙伴/.test(section.title)
            ? 'tabler:shield-check'
            : 'tabler:users-group';
      return isFaq(section) ? (
        <FAQs title={section.title} subtitle={section.subtitle} items={section.items} bg={bg} />
      ) : isProcess(section) ? (
        <Steps
          title={section.title}
          subtitle={flowSubtitle(section)}
          items={flowItems(section.items.filter((item) => !isFlowNote(item))).map((item) => ({
            ...item,
            icon: isSolutionPage ? solutionFlowIcon(item.title) : undefined,
          }))}
          image={section.image}
          bg={bg}
        />
      ) : isSolutionPage ? (
        <SolutionCards title={section.title} subtitle={section.subtitle} items={section.items} bg={bg} />
      ) : (
        <Features
          title={section.title}
          subtitle={section.subtitle}
          items={section.items}
          columns={section.items.length > 3 ? 3 : 2}
          defaultIcon={aboutIcon}
          bg={bg}
        />
      );
    })
}

{isPartnersPage && <PartnerGrid />}

{
  isCaseArchive && caseCards.length > 0 ? (
    <CaseStudyGrid
      title="全部案例"
      actionText="查看案例"
      categories={caseCategories}
      filterable={caseCategories.length > 0}
      items={caseCards}
    />
  ) : isResourceArchive && resourceCards.length > 0 ? (
    <CaseStudyGrid
      title={resourceGridTitle}
      actionText={resourceActionText}
      categories={resourceCategories}
      filterable={resourceCategories.length > 0}
      items={resourceCards}
    />
  ) : (
    !isCaseDetail &&
    !isResourceDetail &&
    children.length > 0 && (
      <Features
        title="相关内容"
        items={children.map((child) => ({
          title: child.title,
          icon: 'tabler:arrow-up-right',
          callToAction: { text: '查看详情', href: child.path },
        }))}
        columns={children.length > 3 ? 3 : 2}
      />
    )
  )
}

{
  isCaseArchive && caseCards.length > 0 && (
    <CaseStudyGrid title="精选案例" actionText="查看案例" items={caseCards.slice(0, 1)} />
  )
}

{
  isResourceArchive &&
    resourceListSection?.items.some((item) => /精选文章/.test(item.title)) &&
    resourceCards.length > 0 && (
      <CaseStudyGrid title="精选文章" actionText="阅读文章" items={resourceCards.slice(0, 1)} />
    )
}

{
  !isCaseDetail && !isResourceDetail && (
    <CallToAction
      title={
        clean(ctaSection?.items.find((item) => /标题/.test(item.title))?.description ?? '') || '先从一次增长诊断开始'
      }
      subtitle="告诉我们你的业务目标、现有网站或广告账户，我们会先给出可执行的方向。"
      actions={[
        {
          variant: 'primary',
          text: clean(ctaAction?.description ?? '') || ctaAction?.title || '联系 Adelie',
          href: '/contact',
        },
      ]}
    />
  )
}

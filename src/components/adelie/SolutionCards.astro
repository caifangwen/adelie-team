---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

interface Props {
  title: string;
  subtitle?: string;
  items: Array<{ title: string; description?: string }>;
  bg?: string;
}

const { title, subtitle, items, bg } = Astro.props;
const isObstacle = /障碍/.test(title);
---

<WidgetWrapper containerClass="max-w-6xl" bg={bg}>
  <Headline title={title} subtitle={subtitle} />
  <div class:list={['grid gap-5', isObstacle ? 'lg:grid-cols-3' : 'md:grid-cols-2']}>
    {
      items.map((item, index) => (
        <article class="group relative min-h-48 overflow-hidden border-2 border-black bg-page p-6 shadow-[6px_6px_0_#18181b] transition-transform hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[10px_10px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff] dark:hover:shadow-[10px_10px_0_#fff]">
          <span class="absolute right-5 top-4 text-sm font-bold text-muted">0{index + 1}</span>
          <div
            class:list={[
              'mb-7 flex h-11 w-11 items-center justify-center border-2 border-black text-black dark:border-white',
              isObstacle ? 'bg-page dark:bg-page' : 'bg-accent',
            ]}
          >
            <Icon name={isObstacle ? 'tabler:alert-triangle' : 'tabler:circle-check'} class="h-5 w-5" />
          </div>
          <h3 class="max-w-[85%] text-xl font-bold md:text-2xl">{item.title}</h3>
          {item.description && <p class="mt-3 text-muted" set:html={item.description} />}
        </article>
      ))
    }
  </div>
</WidgetWrapper>

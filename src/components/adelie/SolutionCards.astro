---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

interface Props {
  title: string;
  subtitle?: string;
  items: Array<{ title: string; description?: string }>;
  images?: Array<{ src: string; alt: string }>;
  bg?: string;
}

const { title, subtitle, items, images = [], bg } = Astro.props;
const hasMedia = images.length > 0;
const isObstacle = /障碍/.test(title);
const isRelated = /案例|指南|工具/.test(title);
const isAudience = /适用|业务场景|判断/.test(title);
const isChecklist = /清单|推荐|交付|能力|重点/.test(title);
const icon = isObstacle
  ? 'tabler:alert-triangle'
  : isRelated
    ? 'tabler:arrow-up-right'
    : isAudience
      ? 'tabler:target-arrow'
      : isChecklist
        ? 'tabler:list-check'
        : 'tabler:circle-check';
const hrefFrom = (description = '') => description.match(/href="([^"]+)"/)?.[1];
const textFrom = (description = '') => description.replace(/<a[^>]*>|<\/a>/g, '');
---

<WidgetWrapper containerClass="max-w-6xl" bg={bg}>
  <Headline title={title} subtitle={subtitle} />
  <div
    class:list={[
      'grid gap-8',
      hasMedia && !isRelated && 'lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch',
    ]}
  >
    {hasMedia && (
      <div
        class:list={[
          'grid min-h-80 gap-3',
          images.length > 1 && !isRelated && 'grid-cols-2 grid-rows-2',
          isRelated && 'grid-cols-1 sm:grid-cols-3 sm:min-h-64',
          isChecklist && !isRelated && 'lg:order-2',
        ]}
      >
        {images.slice(0, 3).map((image, index) => (
          <div
            class:list={[
              'relative min-h-44 overflow-hidden border-2 border-black shadow-[5px_5px_0_#18181b] dark:border-white dark:shadow-[5px_5px_0_#fff]',
              index === 0 && images.length > 1 && !isRelated && 'col-span-2',
              isRelated && index === 1 && 'sm:-translate-y-4',
            ]}
          >
            <Image
              {...image}
              width={900}
              height={600}
              widths={[480, 768, 900]}
              sizes="(max-width: 1024px) 100vw, 42vw"
              layout="full-width"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 hover:scale-105"
            />
            <div class="absolute bottom-0 left-0 bg-accent px-3 py-1 text-xs font-bold text-black">0{index + 1} / FIELD</div>
          </div>
        ))}
      </div>
    )}
    <div
      class:list={[
        'grid gap-5',
        hasMedia && !isRelated ? 'sm:grid-cols-2' : isObstacle || isRelated ? 'lg:grid-cols-3' : 'md:grid-cols-2',
        isChecklist && hasMedia && 'lg:order-1',
      ]}
    >
    {
      items.map((item, index) => {
        const href = hrefFrom(item.description);
        const Card = href ? 'a' : 'article';
        return (
          <Card
            {...(href ? { href } : {})}
            class:list={[
              'group relative min-h-48 overflow-hidden border-2 border-black p-6 shadow-[6px_6px_0_#18181b] transition-transform hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[10px_10px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff] dark:hover:shadow-[10px_10px_0_#fff]',
              isObstacle ? 'bg-[#ffe8e8]' : isRelated ? 'bg-accent text-black' : 'bg-page',
              isChecklist && hasMedia && index === 0 && 'sm:row-span-2 sm:min-h-[25rem] bg-[#dcecff] dark:bg-zinc-800',
              !isObstacle && !isRelated && !isChecklist && index % 3 === 1 && 'bg-[#f4ffd2] dark:bg-zinc-800',
              isRelated && index % 3 === 1 && 'bg-[#9dcdf0]',
              isRelated && index % 3 === 2 && 'bg-[#ff9a91]',
            ]}
          >
            <span class="absolute right-5 top-4 text-sm font-bold opacity-60">
              {isRelated ? 'OPEN ↗' : String(index + 1).padStart(2, '0')}
            </span>
            <div
              class:list={[
                'mb-7 flex h-12 w-12 items-center justify-center border-2 border-black text-black',
                isObstacle
                  ? 'bg-[#ff6b6b]'
                  : isAudience
                    ? 'bg-[#5da2cf]'
                    : isRelated
                      ? index % 2
                        ? 'bg-accent'
                        : 'bg-page'
                      : 'bg-accent',
              ]}
            >
              <Icon name={icon} class="h-6 w-6" />
            </div>
            <h3 class="max-w-[85%] text-xl font-bold md:text-2xl">{item.title}</h3>
            {item.description && <p class:list={['mt-3', isRelated ? 'text-black/70' : 'text-muted']}>{textFrom(item.description)}</p>}
            {isChecklist && !isRelated && <div class="absolute bottom-0 left-0 h-2 w-full bg-primary" />}
          </Card>
        );
      })
    }
    </div>
  </div>
</WidgetWrapper>

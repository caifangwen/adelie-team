---
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';

type Item = { title: string; description?: string };
type Section = { title: string; subtitle?: string; items: Item[] };

interface Props {
  title: string;
  tagline?: string;
  subtitle?: string;
  image?: { src: string; alt: string };
  metrics: string[];
  notice?: string;
  sections: Section[];
}

const { title, tagline, subtitle, image, metrics, notice, sections } = Astro.props;
---

<section class="relative not-prose md:-mt-[76px]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
    <div class="grid items-center gap-8 py-12 md:grid-cols-2 md:gap-12 md:py-20">
      <div>
        {
          tagline && (
            <p class="text-base font-bold tracking-wide text-secondary uppercase dark:text-blue-200">{tagline}</p>
          )
        }
        <h1 class="mt-3 text-4xl font-bold tracking-tighter md:text-5xl">{title}</h1>
        {subtitle && <p class="mt-5 text-xl text-muted dark:text-slate-300">{subtitle}</p>}
        {
          metrics.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-3" aria-label="案例成果">
              {metrics.map((metric) => (
                <li class="border-2 border-black bg-accent px-3 py-2 font-bold text-black">{metric}</li>
              ))}
            </ul>
          )
        }
        {notice && <p class="mt-6 border-l-4 border-primary pl-4 text-sm text-muted">{notice}</p>}
      </div>
      {
        image && (
          <Image
            src={image.src}
            alt={image.alt}
            width={1200}
            height={675}
            widths={[400, 768, 1200]}
            layout="full-width"
            class="w-full border-2 border-black shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff]"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </div>
  </div>
</section>

{
  sections.map((section, index) => (
    <section class:list={['relative not-prose', { 'bg-secondary/5 dark:bg-white/5': index % 2 === 1 }]}>
      <div class="mx-auto max-w-5xl px-4 py-12 md:px-6 md:py-16">
        <h2 class="text-3xl font-bold tracking-tighter md:text-4xl">{section.title}</h2>
        {section.subtitle && <p class="mt-4 max-w-3xl text-xl text-muted">{section.subtitle}</p>}
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {section.items.map((item) => (
            <article class="border-l-2 border-primary pl-4">
              <h3 class="text-xl font-bold">{item.title}</h3>
              {item.description && <p class="mt-2 text-muted">{item.description}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))
}

<section class="not-prose px-4 py-12 md:py-16">
  <div
    class="mx-auto max-w-5xl border-2 border-black bg-accent p-6 shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff] md:p-8"
  >
    <h2 class="text-3xl font-bold tracking-tighter">想把你的案例讲得更有说服力？</h2>
    <p class="mt-3 text-lg text-black/75">从现有网站、内容或广告账户开始，先找出最影响转化的环节。</p>
    <Button variant="primary" text="获取增长诊断" href="/contact" class="mt-6" />
  </div>
</section>

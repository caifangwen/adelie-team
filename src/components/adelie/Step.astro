---
interface Props {
  number: number;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
const label = String(number).padStart(2, '0');
---

<li class="border-2 border-black bg-page p-5 shadow-[5px_5px_0_#18181b] dark:border-white dark:shadow-[5px_5px_0_#fff]">
  <span class="inline-flex bg-accent px-2 py-1 font-bold text-black">{label}</span>
  <h3 class="mt-5 text-xl font-bold">{title.replace(/^\d+\s*/, '')}</h3>
  <p class="mt-3 text-muted">{description}</p>
</li>

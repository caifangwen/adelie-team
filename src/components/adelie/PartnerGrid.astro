---
const platforms = [
  {
    mark: 'W',
    name: 'WordPress',
    scope: '企业官网、内容架构、可编辑模块与基础 SEO 配置。',
    href: 'https://wordpress.org',
  },
  {
    mark: 'S',
    name: 'Shopify',
    scope: '商店搭建、主题定制、市场配置与商品购买体验。',
    href: 'https://www.shopify.com',
  },
  {
    mark: 'G',
    name: 'Google Ads',
    scope: 'Search、Shopping、PMax 策略、转化追踪与账户优化。',
    href: 'https://ads.google.com',
  },
  {
    mark: 'A',
    name: 'Google Analytics & Tag Manager',
    scope: 'GA4、GTM、事件设计、数据口径与报告基础。',
    href: 'https://marketingplatform.google.com/about/analytics/',
  },
];
---

<section class="relative not-prose bg-secondary/5 dark:bg-white/5">
  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16 lg:py-20">
    <div class="mx-auto mb-8 max-w-3xl text-center md:mb-12">
      <p class="text-sm font-bold tracking-wide text-primary uppercase">PLATFORMS</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tighter md:text-4xl">认证与合作伙伴</h2>
      <p class="mt-3 text-muted">以下是项目交付中实际覆盖的平台与工具，可直接查看其官方信息。</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {
        platforms.map((platform) => (
          <article class="border-2 border-black bg-page p-6 shadow-[6px_6px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff]">
            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center border-2 border-black bg-accent text-xl font-bold text-black">
                {platform.mark}
              </span>
              <div>
                <h3 class="text-2xl font-bold">{platform.name}</h3>
                <p class="mt-1 text-sm font-semibold text-primary">服务覆盖中</p>
              </div>
            </div>
            <p class="mt-5 text-muted">{platform.scope}</p>
            <a
              class="mt-6 inline-block font-semibold underline underline-offset-4 hover:text-primary"
              href={platform.href}
              target="_blank"
              rel="noreferrer"
            >
              查看官网 →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

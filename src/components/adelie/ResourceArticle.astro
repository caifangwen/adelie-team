---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

interface Props {
  title?: string;
  excerpt?: string;
  image?: string;
  category?: string;
  readingTime?: string;
}

const { title = '实用资源', excerpt, image, category = '实用资源', readingTime } = Astro.props;
---

<article>
  <header class="not-prose mx-auto grid max-w-7xl items-center gap-8 px-4 py-12 md:grid-cols-2 md:px-6 md:py-20">
    <div>
      <p class="font-bold tracking-wide text-secondary uppercase dark:text-blue-200">
        {category}{readingTime && ` · ${readingTime}`}
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tighter md:text-5xl">{title}</h1>
      {excerpt && <p class="mt-5 text-xl text-muted dark:text-slate-300">{excerpt}</p>}
    </div>
    {
      image && (
        <Image
          src={image}
          alt={title}
          width={1200}
          height={675}
          widths={[400, 768, 1200]}
          layout="full-width"
          class="w-full border-2 border-black shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff]"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </header>

  <div class="prose prose-lg prose-zinc prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tighter prose-h2:mt-14 prose-h2:border-b-2 prose-h2:border-black prose-h2:pb-3 prose-h2:text-3xl prose-h3:text-xl prose-p:leading-8 prose-a:font-semibold prose-a:text-primary prose-li:my-2 dark:prose-invert dark:prose-h2:border-white mx-auto max-w-3xl px-4 pb-16 md:px-6">
    <slot />
  </div>

  <section class="not-prose mx-auto mb-16 max-w-5xl border-2 border-black bg-accent p-6 shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff] md:p-8">
    <h2 class="text-3xl font-bold tracking-tighter text-black">需要把方法应用到你的业务？</h2>
    <p class="mt-3 text-lg text-black/75">提交现有网站、目标市场和当前问题，我们会先给出可执行的优先级建议。</p>
    <Button variant="primary" text="获取初步建议" href="/contact" class="mt-6" />
  </section>
</article>

---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Step from '~/components/adelie/Step.astro';
import type { ServicePageData } from '~/data/services';

interface Props {
  service: ServicePageData;
}

const { service } = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
        <div>
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            {service.tagline}
          </p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            {service.title}
          </h1>
          <p class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            {service.subtitle}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <Button variant="primary" text={service.action} href="/contact" class="w-full sm:w-auto" />
          </div>
        </div>
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <Image
            src={service.image.src}
            alt={service.image.alt}
            width={1024}
            height={576}
            widths={[400, 768, 1024]}
            layout="full-width"
            class="w-full border-2 border-black shadow-[8px_8px_0_#18181b] dark:border-white dark:shadow-[8px_8px_0_#fff]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<Features title={service.problemsTitle} items={service.problems} columns={service.problems.length > 3 ? 2 : 3} />

<Features
  title={service.deliverablesTitle}
  items={service.deliverables}
  columns={service.deliverables.length > 3 ? 3 : 2}
/>

<WidgetWrapper containerClass="max-w-5xl">
  <h2 class="mb-8 text-center text-3xl font-bold tracking-tighter md:mb-12 md:text-4xl">{service.processTitle}</h2>
  <ol class="grid gap-6 md:grid-cols-2">
    {service.process.map((step, index) => <Step number={index + 1} {...step} />)}
  </ol>
</WidgetWrapper>

<Features title="你会获得什么" items={service.outcomes} columns={3} />

<FAQs title="常见问题" items={service.faqs} columns={3} />

<CallToAction
  title={service.cta.title}
  subtitle={service.cta.subtitle}
  actions={[{ variant: 'primary', text: service.cta.action, href: '/contact' }]}
/>

---
import Layout from '~/layouts/PageLayout.astro';

import Button from '~/components/ui/Button.astro';
import Form from '~/components/ui/Form.astro';
import Accordion from '~/components/ui/Accordion.astro';
import Avatar from '~/components/ui/Avatar.astro';
import AvatarGroup from '~/components/ui/AvatarGroup.astro';
import Badge from '~/components/ui/Badge.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import DropArea from '~/components/ui/DropArea.astro';
import InputAddon from '~/components/ui/InputAddon.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Note from '~/components/widgets/Note.astro';
import Brands from '~/components/widgets/Brands.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Contact from '~/components/widgets/Contact.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Component Showcase',
};

const sampleNav = {
  links: [
    { text: 'Home', href: getPermalink('/') },
    { text: 'Blog', href: getBlogPermalink() },
    { text: 'Components', href: getPermalink('/components') },
  ],
  actions: [],
};

const sampleFooter = {
  links: [
    {
      title: 'Site',
      links: [
        { text: 'Home', href: getPermalink('/') },
        { text: 'Blog', href: getBlogPermalink() },
        { text: 'Components', href: getPermalink('/components') },
      ],
    },
  ],
  secondaryLinks: [],
  socialLinks: [],
  footNote: 'Footer sample.',
};

---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">Component Showcase</p>
      <h1 class="font-heading text-4xl font-bold tracking-tighter md:text-5xl">Minimal UI reference</h1>
      <p class="mt-4 text-lg text-muted">
        A compact preview of the base elements and AstroWind widgets kept in this template.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="mb-6 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">UI Patterns</p>
      <h2 class="font-heading text-3xl font-bold tracking-tighter">Common interface elements</h2>
      <p class="mt-2 text-muted">Additional UI patterns from the reference, kept as a compact design vocabulary.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Accordion · 折叠面板</h3>
        <Accordion title="What is included?">A native expandable content area.</Accordion>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Avatar · 头像</h3>
        <div class="flex items-center gap-3">
          <Avatar initials="AL" label="Alex Lee" />
          <div><strong>Alex Lee</strong><p class="text-sm text-muted">Designer</p></div>
        </div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Avatar list · 头像列表</h3>
        <AvatarGroup items={[{ initials: 'AL' }, { initials: 'MK' }, { initials: '+8' }]} />
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Badge · 徽标</h3>
        <div class="flex items-center gap-3"><button type="button" class="border-2 border-black px-3 py-2 font-semibold dark:border-white">Inbox</button><Badge label="3" /></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Breadcrumb · 面包屑</h3>
        <Breadcrumbs items={[{ text: 'Home', href: '#' }, { text: 'Library', href: '#' }, { text: 'Components' }]} />
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Button with icon · 图标按钮</h3>
        <button type="button" class="inline-flex items-center gap-2 border-2 border-black bg-primary px-4 py-2 font-bold shadow-[3px_3px_0_#18181b] dark:border-white dark:shadow-[3px_3px_0_#fff]"><span aria-hidden="true">→</span> Continue</button>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Card · 内容卡片</h3>
        <article class="border-2 border-black p-3 dark:border-white"><p class="text-xs font-bold text-primary">NEW</p><h4 class="mt-1 font-bold">Project update</h4><p class="mt-1 text-sm text-muted">A compact content block.</p></article>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Centering · 居中布局</h3>
        <div class="grid h-24 place-items-center border-2 border-dashed border-black dark:border-white"><span class="border-2 border-black bg-accent px-3 py-1 font-bold dark:border-white">Centered</span></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Circular navigation · 环形导航</h3>
        <div class="relative mx-auto h-24 w-24 rounded-full border-2 border-black dark:border-white"><button type="button" class="absolute left-1/2 top-1/2 h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary text-xs font-bold">1</button><span class="absolute left-2 top-2 h-3 w-3 rounded-full bg-accent"></span><span class="absolute right-2 top-2 h-3 w-3 rounded-full bg-accent"></span><span class="absolute bottom-2 left-1/2 h-3 w-3 -translate-x-1/2 rounded-full bg-accent"></span></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Cookie banner · Cookie 提示</h3>
        <div class="border-2 border-black p-3 text-sm dark:border-white"><p>We use cookies for essential settings.</p><button type="button" class="mt-3 border-2 border-black bg-accent px-2 py-1 font-bold dark:border-white">Accept</button></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Corner ribbon · 角标丝带</h3>
        <div class="relative h-24 overflow-hidden border-2 border-black p-3 dark:border-white"><span class="absolute right-[-28px] top-3 rotate-45 bg-primary px-8 py-1 text-xs font-black">NEW</span><p class="pt-10 text-sm text-muted">Marked content</p></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Custom checkbox · 复选框</h3>
        <label class="flex cursor-pointer items-center gap-3 font-semibold"><input class="h-5 w-5 accent-primary" type="checkbox" checked /> Send weekly updates</label>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Custom radio button · 单选框</h3>
        <fieldset class="space-y-2"><legend class="sr-only">Plan</legend><label class="flex items-center gap-2"><input class="accent-primary" type="radio" name="demo-plan" checked /> Starter</label><label class="flex items-center gap-2"><input class="accent-primary" type="radio" name="demo-plan" /> Pro</label></fieldset>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Docked corner · 停靠角落</h3>
        <div class="relative h-24 border-2 border-black dark:border-white"><button type="button" class="absolute bottom-0 right-0 border-l-2 border-t-2 border-black bg-accent px-3 py-2 text-xs font-bold dark:border-white">Help?</button></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Dot leader · 点状引导线</h3>
        <div class="flex items-end gap-2 text-sm"><span>Shipping</span><span class="mb-1 flex-1 border-b-2 border-dotted border-black dark:border-white"></span><strong>$12</strong></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Dot navigation · 圆点导航</h3>
        <div class="flex gap-3"><button type="button" aria-label="Slide 1" class="h-3 w-3 rounded-full bg-primary"></button><button type="button" aria-label="Slide 2" class="h-3 w-3 rounded-full border-2 border-black dark:border-white"></button><button type="button" aria-label="Slide 3" class="h-3 w-3 rounded-full border-2 border-black dark:border-white"></button></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Drop area · 拖放区域</h3>
        <DropArea />
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Drop cap · 首字下沉</h3>
        <p class="text-sm leading-6"><span class="float-left mr-2 text-5xl font-black leading-9 text-primary">T</span>his opening paragraph uses a raised first letter to start an editorial story.</p>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Dropdown · 下拉菜单</h3>
        <label class="text-sm font-semibold" for="demo-select">Choose a view</label><select id="demo-select" class="mt-2 block w-full border-2 border-black bg-page px-3 py-2 dark:border-white"><option>Grid</option><option>List</option></select>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Feature list · 功能列表</h3>
        <ul class="space-y-2 text-sm"><li class="flex gap-2"><b class="text-primary">✓</b> Instant setup</li><li class="flex gap-2"><b class="text-primary">✓</b> Accessible defaults</li><li class="flex gap-2"><b class="text-primary">✓</b> Static output</li></ul>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Fixed at corner · 固定角标</h3>
        <div class="relative h-24 border-2 border-black dark:border-white"><span class="absolute right-2 top-2 border-2 border-black bg-primary px-2 py-1 text-xs font-bold dark:border-white">3</span></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Floating label · 浮动标签</h3>
        <div class="relative pt-2"><label class="absolute left-2 top-0 bg-white px-1 text-xs font-bold dark:bg-zinc-900" for="demo-email">Email</label><input id="demo-email" class="w-full border-2 border-black bg-page px-3 py-3 dark:border-white" type="email" value="hello@example.com" /></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Full screen menu · 全屏菜单</h3>
        <details><summary class="cursor-pointer border-2 border-black px-3 py-2 font-bold dark:border-white">Open menu</summary><nav class="mt-2 border-2 border-black p-3 dark:border-white"><a class="block py-1 underline" href="#">Work</a><a class="block py-1 underline" href="#">About</a><a class="block py-1 underline" href="#">Contact</a></nav></details>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Initial avatar · 首字母头像</h3>
        <span class="grid h-14 w-14 place-items-center rounded-full border-2 border-black bg-primary text-lg font-black dark:border-white">PN</span>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Input addon · 输入框附加项</h3>
        <label class="sr-only" for="demo-url">Website URL</label><InputAddon addon="https://" name="demo-url" value="example.com" />
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Media object · 媒体对象</h3>
        <div class="flex gap-3"><span class="grid h-12 w-12 shrink-0 place-items-center border-2 border-black bg-accent font-black dark:border-white">M</span><div><h4 class="font-bold">Media title</h4><p class="text-sm text-muted">Image or icon with supporting copy.</p></div></div>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Menu · 菜单</h3>
        <nav aria-label="Example menu" class="border-2 border-black dark:border-white"><a class="block border-b-2 border-black px-3 py-2 font-semibold dark:border-white" href="#">Dashboard</a><a class="block border-b-2 border-black px-3 py-2" href="#">Projects</a><a class="block px-3 py-2" href="#">Settings</a></nav>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Modal · 模态框</h3>
        <button type="button" data-modal-open class="border-2 border-black bg-accent px-3 py-2 font-bold dark:border-white">Open modal</button>
        <dialog id="component-modal" class="max-w-sm border-2 border-black bg-page p-0 text-default shadow-[8px_8px_0_#18181b] backdrop:bg-black/50 dark:border-white dark:shadow-[8px_8px_0_#fff]"><div class="p-5"><h4 class="text-lg font-bold">Modal title</h4><p class="mt-2 text-sm text-muted">This is a native dialog element.</p><button type="button" data-modal-close class="mt-4 border-2 border-black px-3 py-2 font-bold dark:border-white">Close</button></div></dialog>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Notification · 通知</h3>
        <button type="button" data-notice-open class="border-2 border-black bg-accent px-3 py-2 font-bold dark:border-white">Show notification</button><p data-notice class="mt-3 hidden border-2 border-black bg-primary p-2 text-sm font-semibold dark:border-white" role="status">Saved successfully.</p>
      </section>

      <section class="border-2 border-black bg-white p-4 dark:border-white dark:bg-zinc-900">
        <h3 class="mb-3 font-bold">Overlay play button · 覆盖播放按钮</h3>
        <div class="grid h-24 place-items-center border-2 border-black bg-accent dark:border-white"><button type="button" aria-label="Play video" class="grid h-12 w-12 place-items-center rounded-full border-2 border-black bg-white text-lg dark:border-white dark:bg-zinc-900">▶</button></div>
      </section>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-6 font-heading text-3xl font-bold tracking-tighter">Base Elements</h2>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="rounded-md border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="mb-4 text-xl font-bold">Buttons</h3>
        <div class="flex flex-wrap gap-3">
          <Button variant="primary" href="#">Primary</Button>
          <Button variant="secondary" href="#">Secondary</Button>
          <Button variant="tertiary" href="#">Tertiary</Button>
          <Button variant="link" href="#">Link</Button>
        </div>
      </div>

      <div class="rounded-md border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="mb-4 text-xl font-bold">Badges</h3>
        <div class="flex flex-wrap gap-3">
          <span class="rounded-full bg-primary px-3 py-1 text-sm font-medium text-white">Primary</span>
          <span class="rounded-full border border-gray-300 px-3 py-1 text-sm font-medium dark:border-slate-600">
            Neutral
          </span>
          <span
            class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700 dark:bg-slate-800 dark:text-slate-200"
          >
            Subtle
          </span>
        </div>
      </div>

      <div class="rounded-md border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="mb-4 text-xl font-bold">Typography</h3>
        <div class="space-y-3">
          <h1 class="font-heading text-4xl font-bold tracking-tighter">Heading 1</h1>
          <h2 class="font-heading text-3xl font-bold tracking-tighter">Heading 2</h2>
          <h3 class="font-heading text-2xl font-bold">Heading 3</h3>
          <h4 class="text-xl font-bold">Heading 4</h4>
          <h5 class="text-lg font-bold">Heading 5</h5>
          <h6 class="text-base font-bold">Heading 6</h6>
          <p class="text-muted">Body text uses the default muted color for supporting copy.</p>
          <blockquote class="border-l-4 border-gray-300 pl-4 text-muted dark:border-slate-600">
            A simple quote style for editorial content.
          </blockquote>
        </div>
      </div>

      <div class="rounded-md border border-gray-200 p-6 dark:border-slate-700">
        <h3 class="mb-4 text-xl font-bold">Form</h3>
        <Form
          inputs={[
            { type: 'text', name: 'name', label: 'Name', placeholder: 'Jane Doe' },
            { type: 'email', name: 'email', label: 'Email', placeholder: 'jane@example.com' },
          ]}
          textarea={{ label: 'Message', name: 'message', placeholder: 'Short message', rows: 3 }}
          button="Submit"
        />
      </div>

      <div class="rounded-md border border-gray-200 p-6 dark:border-slate-700 lg:col-span-2">
        <h3 class="mb-4 text-xl font-bold">Card</h3>
        <div class="max-w-md rounded-md border border-gray-200 p-5 dark:border-slate-700">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">Card label</p>
          <h4 class="mt-2 text-xl font-bold">Simple content card</h4>
          <p class="mt-2 text-muted">Use this pattern for small repeated content blocks.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-6 font-heading text-3xl font-bold tracking-tighter">Widgets</h2>
  </section>

  <Announcement />

  <div class="border-y border-gray-200 dark:border-slate-800">
    <Header id="showcase-header" {...sampleNav} />
  </div>

  <Hero
    actions={[
      { variant: 'primary', text: 'Primary action', href: '#' },
      { text: 'Secondary action', href: '#' },
    ]}
  >
    <Fragment slot="title">Hero section</Fragment>
    <Fragment slot="subtitle">A centered hero with title, subtitle, and two actions.</Fragment>
  </Hero>

  <Hero2
    tagline="Hero variant"
    actions={[
      { variant: 'primary', text: 'Start', href: '#' },
      { variant: 'secondary', text: 'Learn more', href: '#' },
    ]}
  >
    <Fragment slot="title">Split hero layout</Fragment>
    <Fragment slot="subtitle">Use this variant when the hero needs left-aligned copy and optional media.</Fragment>
  </Hero2>

  <Note title="Note:" description="A compact announcement-style information band for lightweight page context." />

  <Features
    title="Features"
    subtitle="A compact feature grid with common icon and text items."
    columns={3}
    items={[
      { title: 'Fast setup', description: 'Start from a small set of routes.', icon: 'tabler:bolt' },
      { title: 'Composable', description: 'Build pages from reusable widgets.', icon: 'tabler:layout-grid' },
      { title: 'Neutral style', description: 'Adjust tokens and classes later.', icon: 'tabler:palette' },
    ]}
  />

  <Features2
    title="Feature cards"
    subtitle="A card-based feature grid for denser product or service summaries."
    columns={3}
    items={[
      { title: 'Cards', description: 'Useful for grouped capabilities.', icon: 'tabler:cards' },
      { title: 'Actions', description: 'Each item can include a link.', icon: 'tabler:arrow-right' },
      { title: 'Icons', description: 'Icons are optional and reusable.', icon: 'tabler:icons' },
    ]}
  />

  <Features3
    title="Feature detail"
    subtitle="A wider feature block with optional media and supporting points."
    columns={2}
    items={[
      { title: 'Point one', description: 'Short supporting text for the detail block.', icon: 'tabler:check' },
      { title: 'Point two', description: 'Another concise benefit or capability.', icon: 'tabler:check' },
    ]}
  />

  <Steps
    title="Steps"
    subtitle="A short process timeline."
    items={[
      { title: 'Plan', description: 'Choose the sections you need.', icon: 'tabler:list-check' },
      { title: 'Compose', description: 'Arrange widgets into pages.', icon: 'tabler:layout' },
      { title: 'Style', description: 'Tune tokens and component defaults.', icon: 'tabler:paint' },
    ]}
  />

  <Content
    title="Content"
    subtitle="Text and supporting points in a two-column content section."
    items={[
      { title: 'Readable', description: 'Keep copy short and scannable.' },
      { title: 'Flexible', description: 'Use slots or props depending on the page.' },
    ]}
  >
    <Fragment slot="content">
      <p>Use the content widget when a page needs explanatory text next to a concise set of supporting points.</p>
    </Fragment>
  </Content>

  <Stats
    title="Stats"
    subtitle="Simple metrics for proof points or operational summaries."
    stats={[
      { title: 'Pages', amount: '5' },
      { title: 'Posts', amount: '2' },
      { title: 'Widgets', amount: '8' },
      { title: 'Theme', amount: '1' },
    ]}
  />

  <FAQs
    title="FAQs"
    subtitle="A basic question list."
    columns={2}
    items={[
      { title: 'Can I remove widgets?', description: 'Yes. Keep only the components your site uses.' },
      { title: 'Where do I tune styles?', description: 'Start with Tailwind tokens and CustomStyles.' },
    ]}
  />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-6 font-heading text-3xl font-bold tracking-tighter">Special Sections</h2>
  </section>

  <Brands
    title="Brands"
    subtitle="A simple logo or icon strip."
    icons={['tabler:brand-astro', 'tabler:brand-tailwind', 'tabler:brand-typescript', 'tabler:brand-github']}
  />

  <Pricing
    title="Pricing"
    subtitle="A common plan selection section."
    prices={[
      {
        title: 'Starter',
        subtitle: 'For simple sites',

---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Adelie｜为增长而建的网站、SEO 与 Google Ads',
  ignoreTitleTemplate: true,
};

const industrySolutions = [
  {
    number: '01',
    title: 'B2B 外贸',
    description: '用产品页、行业页和信任内容，把海外搜索变成有效询盘。',
    icon: 'tabler:briefcase',
    href: '/solutions/b2b-export',
  },
  {
    number: '02',
    title: 'DTC 品牌',
    description: '用品牌型 Shopify 商店和落地页，让投放流量更容易成交。',
    icon: 'tabler:brand-shopee',
    href: '/solutions/dtc-brand',
  },
  {
    number: '03',
    title: '跨境电商',
    description: '从多市场商店到广告归因，搭建可以规模化运营的销售链路。',
    icon: 'tabler:world',
    href: '/solutions/cross-border-ecommerce',
  },
  {
    number: '04',
    title: '企业官网获客',
    description: '把公司介绍升级为可被搜索、可被衡量的获客资产。',
    icon: 'tabler:layout-dashboard',
    href: '/solutions/corporate-lead-gen',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="WORDPRESS · SHOPIFY · SEO · GOOGLE ADS"
    title="不只做一个好看的网站，更做一个能带来增长的网站。"
    subtitle="我们为出海品牌、B2B 企业与跨境卖家提供建站、自然流量和 Google Ads 增长服务，让每一次访问更接近询盘与订单。"
    actions={[
      { variant: 'primary', text: '免费获取增长诊断', href: '/contact' },
      { text: '查看真实案例', href: '/cases/wordpress' },
    ]}
  />

  <Features
    title="从网站基础，到持续获客。"
    subtitle="策略、设计、开发与投放围绕同一份增长计划协作，不让流量和页面各自为战。"
    columns={2}
    items={[
      {
        title: 'WordPress 建站',
        description: '为复杂业务建立清晰、易维护的企业官网与获客站。',
        icon: 'tabler:building-store',
        callToAction: { text: '了解 WordPress 建站', href: '/services/wordpress' },
      },
      {
        title: 'Shopify 独立站',
        description: '为 DTC 品牌打造更有说服力、更容易成交的独立站。',
        icon: 'tabler:shopping-bag',
        callToAction: { text: '了解 Shopify 建站', href: '/services/shopify' },
      },
      {
        title: 'SEO 自然流量增长',
        description: '用高意向内容和技术优化，建立持续的自然流量。',
        icon: 'tabler:search',
        callToAction: { text: '了解 SEO 服务', href: '/services/seo' },
      },
      {
        title: 'Google Ads 投放',
        description: '用可衡量的广告投放，把预算投向真实业务机会。',
        icon: 'tabler:chart-line',
        callToAction: { text: '了解广告投放', href: '/services/sem' },
      },
    ]}
  />

  <WidgetWrapper
    id="industry-solutions"
    containerClass="max-w-6xl"
    bg={'<div class="absolute inset-0 bg-secondary/5 dark:bg-white/5"></div>'}
  >
    <Headline title="不同的生意，需要不同的增长路径。" />
    <div class="grid gap-5 sm:grid-cols-2">
      {
        industrySolutions.map((solution) => (
          <a
            href={solution.href}
            class="group relative flex min-h-56 flex-col overflow-hidden border-2 border-black bg-page p-6 shadow-[6px_6px_0_#18181b] transition-all hover:-translate-x-1 hover:-translate-y-1 hover:bg-accent hover:shadow-[10px_10px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff] dark:hover:shadow-[10px_10px_0_#fff]"
          >
            <span class="absolute right-5 top-4 text-sm font-bold text-muted">{solution.number}</span>
            <div class="mb-8 flex h-12 w-12 items-center justify-center border-2 border-black bg-accent text-black group-hover:bg-page dark:border-white dark:group-hover:bg-page">
              <Icon name={solution.icon} class="h-6 w-6" />
            </div>
            <h3 class="text-2xl font-bold group-hover:text-black">{solution.title}</h3>
            <p class="mt-3 max-w-md text-muted group-hover:text-black">{solution.description}</p>
            <span class="mt-auto pt-8 font-semibold underline underline-offset-4">查看方案 →</span>
          </a>
        ))
      }
    </div>
  </WidgetWrapper>

  <Features
    title="结果应该看得见。"
    subtitle="案例中的数据只在获得验证后展示；未确认的数据不会作为承诺使用。"
    columns={3}
    items={[
      {
        title: '工业设备 B2B 官网重构',
        description: '重组产品、应用与行业信息，让客户更快找到合适方案。',
        icon: 'tabler:building-factory-2',
        callToAction: { text: '查看案例', href: '/cases/wordpress/novatech' },
      },
      {
        title: '生活方式品牌 Shopify 改版',
        description: '先讲核心利益点，再给场景、证据、规格和购买答案。',
        icon: 'tabler:shopping-cart',
        callToAction: { text: '查看案例', href: '/cases/shopify/luma-home' },
      },
      {
        title: '跨境品牌 SEO + Ads 增长',
        description: '统一追踪、内容和落地页，让优化有可靠的判断依据。',
        icon: 'tabler:trending-up',
        callToAction: { text: '查看案例', href: '/cases/seo/atlas-parts' },
      },
    ]}
  />

  <Steps
    title="先看问题，再决定做什么。"
    items={[
      { title: '01 诊断现状', description: '了解你的市场、网站、流量来源与业务目标。' },
      { title: '02 制定优先级', description: '先做最影响询盘、订单或获客成本的事项。' },
      { title: '03 共同执行', description: '设计、开发、SEO 与投放围绕同一份计划推进。' },
      { title: '04 用数据迭代', description: '持续复盘结果，不把上线当作项目结束。' },
    ]}
  />

  <CallToAction
    title="想知道下一个增长机会在哪里？"
    subtitle="提交你的网站或广告账户，我们会先给出初步方向，再决定是否适合合作。"
    actions={[{ variant: 'primary', text: '申请免费诊断', href: '/contact' }]}
  />
</Layout>

---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import ProductCard from '~/components/shop/ProductCard.astro';
import CategoryCard from '~/components/shop/CategoryCard.astro';
import ShopSectionHead from '~/components/shop/ShopSectionHead.astro';
import { products, categories } from '~/data/products';

const metadata = {
  title: '商城首页｜精选好物',
  description: '精选数码、腕表、运动户外与家居生活好物，新用户立减 ¥30，全场满 ¥299 包邮。',
};

const hotProducts = products.filter((p) => p.badge === '热卖').concat(products.filter((p) => !p.badge)).slice(0, 4);
const newProducts = products.filter((p) => p.badge === '新品').concat(products.filter((p) => p.badge === '特惠'));

const promises = [
  ['tabler:truck-delivery', '满额包邮', '全场满 ¥299 免运费'],
  ['tabler:refresh', '7 天无理由', '不满意随时退换'],
  ['tabler:shield-check', '正品保障', '官方渠道，假一赔十'],
  ['tabler:headset', '在线客服', '工作日 9:00 - 21:00'],
];
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-4 py-16 md:px-6 md:py-24 lg:grid-cols-[1.08fr_.92fr] lg:items-center lg:py-28"
    >
      <div>
        <p class="mb-5 text-sm font-bold tracking-[0.16em] text-primary">SELECTED GOODS, FAIR PRICE</p>
        <h1 class="max-w-3xl font-heading text-5xl font-bold leading-[0.98] tracking-tight md:text-7xl lg:text-8xl">
          好东西，<br />
          不贵。
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-muted md:text-xl">
          每一件商品都经过真实使用与横向评测，只留下值得买的那几件。新用户立减 ¥30，全场满 ¥299 包邮。
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button variant="primary" text="立即选购" href="/shop/products" class="justify-center" />
          <Button variant="tertiary" text="查看优惠 →" href="/shop/products" class="justify-center" />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div
          class="relative overflow-hidden border-2 border-black bg-[#c8ed34] p-5 text-black shadow-[12px_12px_0_#18181b] dark:border-white md:p-7"
        >
          <div
            class="flex items-center justify-between border-b border-black/25 pb-4 text-xs font-bold tracking-[0.16em] text-black/65"
          >
            <span>WEEKLY DEAL</span><span>限时 48 小时</span>
          </div>
          <div class="py-7">
            <p class="text-sm font-bold tracking-[0.16em]">全场精选专区</p>
            <div class="mt-4 flex items-end gap-4">
              <strong class="text-7xl font-bold leading-none tracking-tighter md:text-8xl">5折</strong>
              <span class="pb-2 text-sm font-bold tracking-wide">起<br />叠加新客券</span>
            </div>
            <p class="mt-4 max-w-xs text-black/70">耳机、腕表、跑鞋等 20+ 款人气单品直降，售完即止。</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="border-2 border-black bg-page p-4">
              <span class="text-xs text-black/60">新用户专享</span>
              <p class="mt-2 text-2xl font-bold">立减 ¥30</p>
            </div>
            <div class="border-2 border-black bg-[#49b9ae] p-4">
              <span class="text-xs text-black/60">全场通用</span>
              <p class="mt-2 text-2xl font-bold">满 ¥299 包邮</p>
            </div>
          </div>
        </div>
        <p class="mt-4 text-right text-xs font-bold tracking-[0.14em] text-muted">NEW IN · BEST SELLERS · DEALS</p>
      </div>
    </div>
  </section>

  <!-- 分类导航 -->
  <section class="mx-auto max-w-7xl px-4 pb-4 md:px-6">
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
      {categories.map((category) => <CategoryCard {...category} />)}
    </div>
  </section>

  <!-- 本周热卖 -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
    <ShopSectionHead title="本周热卖" subtitle="BEST SELLERS" linkText="查看全部" linkHref="/shop/products" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {hotProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- 促销横幅 -->
  <section class="border-y-2 border-black bg-[#f7bb4e] py-4 text-black dark:border-white">
    <div
      class="mx-auto flex max-w-7xl items-center gap-x-8 gap-y-2 overflow-x-auto px-4 text-sm font-bold tracking-[0.08em] whitespace-nowrap md:px-6"
    >
      <span class="bg-black px-3 py-2 text-[#f7bb4e]">限时福利</span>
      <span>新用户立减 ¥30</span>
      <span>·</span>
      <span>全场满 ¥299 包邮</span>
      <span>·</span>
      <span>7 天无理由退换</span>
      <span>·</span>
      <span>正品保障 假一赔十</span>
    </div>
  </section>

  <!-- 新品上架 -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
    <ShopSectionHead title="新品上架" subtitle="NEW ARRIVALS" linkText="查看全部" linkHref="/shop/products" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {newProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- 服务承诺 -->
  <section class="border-t-2 border-black py-16 dark:border-white md:py-20">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <ShopSectionHead title="买得放心" subtitle="OUR PROMISE" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          promises.map(([icon, title, description]) => (
            <div class="border-2 border-black bg-page p-6 shadow-[6px_6px_0_#18181b] transition-transform hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[10px_10px_0_#18181b] dark:border-white dark:shadow-[6px_6px_0_#fff] dark:hover:shadow-[10px_10px_0_#fff]">
              <Icon name={icon} class="h-8 w-8 text-primary" />
              <h3 class="mt-4 text-xl font-bold">{title}</h3>
              <p class="mt-2 text-sm text-muted">{description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

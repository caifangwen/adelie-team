---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于 Adelie',
  description: 'Adelie 为出海品牌、B2B 企业与跨境卖家提供建站、SEO 与 Google Ads 增长服务。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="ABOUT ADELIE"
    title="不只交付网站，也把获客路径一起搭好。"
    subtitle="Adelie 为出海品牌、B2B 企业与跨境卖家提供 WordPress、Shopify、SEO 与 Google Ads 服务，让策略、页面、流量和数据围绕同一个业务目标协作。"
    actions={[
      { variant: 'primary', text: '获取增长诊断', href: '/contact' },
      { text: '了解合作流程', href: '/about/process' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556761175-b413da4baf72',
      alt: '团队围绕网站增长策略协作',
    }}
  />

  <Features
    title="我们解决的，不只是页面问题"
    subtitle="先找到影响询盘、订单或获客成本的环节，再确定应该做什么。"
    columns={3}
    items={[
      {
        title: '业务与内容不清楚',
        description: '把产品、应用、行业和客户证据组织成海外客户能理解、搜索和咨询的内容。',
        icon: 'tabler:messages',
      },
      {
        title: '网站与流量各自为战',
        description: '让 SEO、广告主张和落地页承接同一个转化路径，不让访问停在点击。',
        icon: 'tabler:route',
      },
      {
        title: '上线后没有判断依据',
        description: '从一开始定义追踪和复盘口径，用可核验数据决定下一步优先级。',
        icon: 'tabler:chart-line',
      },
    ]}
  />

  <Steps
    title="从诊断到复盘，始终围绕同一目标"
    items={[
      { title: '01 了解现状', description: '确认市场、业务目标、现有网站、流量来源和限制条件。' },
      { title: '02 排定优先级', description: '先处理最影响转化的问题，明确交付范围、责任和时间线。' },
      { title: '03 分阶段交付', description: '策略、内容、设计与开发逐步确认，避免方向未定就反复返工。' },
      { title: '04 用数据复盘', description: '检查页面、追踪、流量质量和业务反馈，决定后续动作。' },
    ]}
  />

  <Features
    title="你可以从最需要的部分开始"
    columns={3}
    items={[
      {
        title: '团队与方法论',
        description: '了解策略、设计开发和增长如何协作。',
        icon: 'tabler:users',
        callToAction: { text: '查看团队与方法论', href: '/about/team' },
      },
      {
        title: '合作流程',
        description: '在项目开始前，先知道每一步会发生什么。',
        icon: 'tabler:git-branch',
        callToAction: { text: '查看合作流程', href: '/about/process' },
      },
      {
        title: '平台能力与资质',
        description: '只展示可说明、可验证的真实能力与合作信息。',
        icon: 'tabler:badge',
        callToAction: { text: '查看资质与伙伴', href: '/about/partners' },
      },
    ]}
  />

  <CallToAction
    title="先聊清楚目标，再决定是否适合合作。"
    subtitle="提交网站、商店或广告账户链接，我们会先给出可执行的初步方向。"
    actions={[{ variant: 'primary', text: '发起项目沟通', href: '/contact' }]}
  />
</Layout>

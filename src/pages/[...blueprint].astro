---
import { getCollection, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import BlueprintPage from '~/components/adelie/BlueprintPage.astro';
import ResourceArticle from '~/components/adelie/ResourceArticle.astro';

export const prerender = true;

const pathFromId = (id: string) => id.replace(/(^|\/)index$/, '').replace(/^index$/, '');

export async function getStaticPaths() {
  const pages = await getCollection('blueprint');
  const pathFromId = (id: string) => id.replace(/(^|\/)index$/, '').replace(/^index$/, '');
  return pages.map((page) => {
    const pathname = pathFromId(page.id);
    const children = pages
      .filter((child) => {
        const childPath = pathFromId(child.id);
        return childPath.startsWith(`${pathname}/`) && childPath.split('/').length === pathname.split('/').length + 1;
      })
      .map((child) => ({
        path: `/${pathFromId(child.id)}`,
        title: child.data.title ?? child.body?.match(/^#\s+(.+)$/m)?.[1] ?? pathFromId(child.id),
        body: child.body ?? '',
        data: child.data,
      }));
    return { params: { blueprint: pathname || undefined }, props: { page, children } };
  });
}

const { page, children } = Astro.props;
const body = page.body ?? '';
const title = page.data.title ?? body.match(/^#\s+(.+)$/m)?.[1] ?? 'Adelie';
const isArticle = page.data.kind === 'article';
const { Content } = isArticle ? await render(page) : { Content: null };
---

<Layout metadata={{ title }}>
  {
    isArticle && Content ? (
      <ResourceArticle {...page.data}>
        <Content />
      </ResourceArticle>
    ) : (
      <BlueprintPage body={body} path={pathFromId(page.id)} children={children} />
    )
  }
</Layout>
